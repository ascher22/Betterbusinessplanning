ADMIN_PORTAL_URL=
DATABASE_URL=
DATABASE_BACKUP_FALLBACK=
# CC_ID must match the Control Center deploy EXACTLY.
# Required whenever DATABASE_URL resolves to a shared shard (DB_2...DB_10): the
# admin reads those with "WHERE cc_id = <CC_ID>", so rows written with a NULL
# cc_id are silently invisible in the admin even though every request returns 200.
CC_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SEO admin Telegram - IndexNow deploy notify + SEO alerts
# Required on Vercel BUILD env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=
ALLOW_LOCAL_TESTING=true
NEXT_PUBLIC_ALLOW_LOCAL_TESTING=true

# DB_2=   # shared shard (requires CC_ID)
